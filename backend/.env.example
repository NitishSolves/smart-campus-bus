# Copy this file to backend/.env and fill in real values. Never commit backend/.env.

# PostgreSQL connection string (required).
DATABASE_URL=postgres://user:password@localhost:5432/campus_bus

# Secret used to sign JWTs (required). Use a long random value in production.
JWT_SECRET=change-me-to-a-long-random-secret

# development | production | test
NODE_ENV=development

# API port. Defaults to 3001 when unset (matches the Vite dev proxy).
PORT=3001

# Comma-separated list of extra allowed browser origins (optional).
# CORS_ORIGINS=https://your-frontend.example.com

# Set to "require" when your PostgreSQL provider needs TLS (optional).
# DATABASE_SSL=require
